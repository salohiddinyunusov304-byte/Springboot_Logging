<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="LOG_HOME" value="logs"/>

    <appender name="CONTEXT_FILE" class="ch.qos.logback.classic.sift.SiftingAppender">
        <discriminator class="ch.qos.logback.classic.sift.MDCBasedDiscriminator">
            <key>logPath</key>
            <defaultValue>default</defaultValue>
        </discriminator>
        <sift>
            <appender name="FILE-${logPath}" class="ch.qos.logback.core.rolling.RollingFileAppender">
                <file>${LOG_HOME}/${logPath}/app.log</file>
                <encoder>
                    <charset>UTF-8</charset>
                    <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
                </encoder>
                <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                    <fileNamePattern>${LOG_HOME}/${logPath}/app.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
                    <maxFileSize>100MB</maxFileSize>
                    <maxHistory>1000</maxHistory>
                    <totalSizeCap>0B</totalSizeCap>
                    <cleanHistoryOnStart>false</cleanHistoryOnStart>
                </rollingPolicy>
            </appender>
        </sift>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONTEXT_FILE"/>
    </root>
</configuration>